{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agmt",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-20",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"containers": [
		{
			"class_name": "AgmtContainer",
			"image": "./Dockerfile",
			"max_instances": 2
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "AGMT",
				"class_name": "AgmtContainer"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["AgmtContainer"]
		}
	]
}
