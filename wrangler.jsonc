{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agmt",
	"main": "web/.output/server/index.mjs",
	"assets": {
		"binding": "ASSETS",
		"directory": "web/.output/public"
	},
	"compatibility_date": "2026-09-05",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"vars": {
		"AGMT_DB_ROLE": "agmt_app",
		"AGMT_EXECUTE_ACCESS": "invite",
		"AGMT_FEEDBACK_TO": "dexterinlab@protonmail.com",
		"AGMT_PUBLIC_URL": "https://app.agmt.legal",
		"AUTH_EMAIL_FROM": "Agmt <hello@agmt.legal>"
	},
	"hyperdrive": [
		{ "binding": "AGMT_APP_DB", "id": "6738d0760a774700808fddf13018e36b" },
		{ "binding": "AGMT_AUTH_DB", "id": "d20b71757c7a404f9f02c1ff024b8b55" }
	],
	"r2_buckets": [
		{ "binding": "AGMT_OBJECTS", "bucket_name": "agmt-proof-objects" }
	],
	"kv_namespaces": [
		{ "binding": "AGMT_ACCESS", "id": "64ed6441513549819e50e9955d810bbb" }
	],
	"triggers": {
		"crons": ["* * * * *"]
	}
}
