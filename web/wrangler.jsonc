{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agmt",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    {
      "binding": "AGMT_OBJECTS",
      "bucket_name": "agmt-proof-objects"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "hyperdrive": [
    {
      "binding": "AGMT_APP_DB",
      "id": "6738d0760a774700808fddf13018e36b"
    },
    {
      // Temporary recovery: auth and app use the same Supabase origin.
      // Keep the AGMT_AUTH_DB binding name so a dedicated cache-disabled
      // Hyperdrive can be restored later without a code migration.
      "binding": "AGMT_AUTH_DB",
      "id": "6738d0760a774700808fddf13018e36b"
    }
  ]
}
