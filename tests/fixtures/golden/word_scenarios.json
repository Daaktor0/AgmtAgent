{
  "version": 1,
  "note": "Controlled Word situations for the golden slice. Host-dependent cells are exercised by addin/src/word tests when Word is present; protocol predicates are covered in test_golden_slice.py.",
  "scenarios": [
    {"name": "duplicate_indemnity_wording", "fixture": "DOUBLE_RECOVERY", "expect": "double_recovery"},
    {"name": "clause_selected_inside_table_cell", "fixture": "TABLE_CELL", "expect": "selection_captured_with_table_path"},
    {"name": "selection_spanning_paragraphs", "fixture": "MULTI_PARA", "expect": "paragraph_indexes_length_gte_1"},
    {"name": "pending_tracked_insertion_near_selection", "revisions": [{"type": "insertion", "block_idx": 8}], "expect": "reviewed_current_text"},
    {"name": "pending_tracked_deletion_near_selection", "revisions": [{"type": "deletion", "block_idx": 8}], "expect": "reviewed_current_text"},
    {"name": "comments_replies", "comments": [{"id": "c1", "block_idx": 8, "text": "query", "replies": [{"text": "reply"}]}], "expect": "stable_comment_id"},
    {"name": "indemnity_in_footnote_header_footer", "fixture": "FOOTNOTE_INDEMNITY", "expect": "stories_not_collapsed"},
    {"name": "edited_after_analysis_before_apply", "expect": "stale_refuse"},
    {"name": "protected_read_only", "expect": "protected_refuse"},
    {"name": "track_changes_initially_off", "tracking_mode": "off", "expect": "mode_restored_off"},
    {"name": "track_changes_initially_on", "tracking_mode": "track_all", "expect": "mode_restored_track_all"},
    {"name": "reconnect_after_approval", "expect": "ticket_still_single_use"},
    {"name": "duplicate_apply_replay", "expect": "replay_refuse"},
    {"name": "ambiguous_clause_references", "fixture": "AMBIGUOUS_INDEMNITY", "expect": "ambiguity"},
    {"name": "identical_text_elsewhere", "fixture": "DUPLICATE_TEXT", "expect": "ambiguous_target"}
  ]
}
