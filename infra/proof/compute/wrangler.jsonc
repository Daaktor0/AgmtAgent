{
  "name": "agmt-proof-compute",
  "main": "worker.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "containers": [
    {
      "class_name": "ProofScanContainer",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PROOF_SCAN", "class_name": "ProofScanContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProofScanContainer"] }
  ]
}
