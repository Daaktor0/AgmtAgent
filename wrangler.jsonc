{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agmt",
	"main": "web/.output/server/index.mjs",
	"assets": {
		"binding": "ASSETS",
		"directory": "web/.output/public"
	},
	"compatibility_date": "2026-09-05",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
